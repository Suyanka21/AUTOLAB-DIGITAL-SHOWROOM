{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigurationState",
  "description": "AutoLab Confirmed V1 Flow: Material -> Colour -> Accent Thread -> Interior Composition",
  "type": "object",
  "required": [
    "referenceCode",
    "vehicleId",
    "createdAt",
    "updatedAt",
    "selections"
  ],
  "properties": {
    "referenceCode": {
      "type": "string",
      "pattern": "^AL-[A-Z0-9]{2,4}-[0-9]{4}-[A-Z0-9]{4}$"
    },
    "vehicleId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "selections": {
      "type": "object",
      "required": [
        "primaryMaterialId",
        "primaryColorId",
        "accentThreadId",
        "interiorComposition"
      ],
      "properties": {
        "primaryMaterialId": {
          "type": "string",
          "description": "Confirmed V1 Dimension 1: Material (Primary: Leather)"
        },
        "primaryColorId": {
          "type": "string",
          "description": "Confirmed V1 Dimension 2: Colour (Proposed candidate pending AutoLab approval)"
        },
        "accentThreadId": {
          "type": "string",
          "description": "Confirmed V1 Dimension 3: Accent Thread (Proposed candidate pending AutoLab approval)"
        },
        "interiorComposition": {
          "type": "object",
          "description": "Confirmed V1 Dimension 4: Interior Composition / Visual Configuration",
          "required": ["tier", "appliedZones"],
          "properties": {
            "tier": {
              "type": "string",
              "enum": ["bespoke_monotone", "bespoke_duotone", "executive_fluted"]
            },
            "appliedZones": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "extendedZones": {
          "type": "object",
          "description": "PROPOSED / EXTENDED SELECTIONS (Pending AutoLab Gate 5 confirmation)",
          "properties": {
            "secondaryAccentBolsters": {
              "type": "object",
              "required": ["zoneId", "materialId", "colorId"],
              "properties": {
                "zoneId": { "type": "string" },
                "materialId": { "type": "string" },
                "colorId": { "type": "string" }
              }
            },
            "trimDeckVeneer": {
              "type": "object",
              "required": ["zoneId", "materialId", "colorId"],
              "properties": {
                "zoneId": { "type": "string" },
                "materialId": { "type": "string" },
                "colorId": { "type": "string" }
              }
            },
            "steeringWheel": {
              "type": "object",
              "required": ["zoneId", "materialId", "colorId"],
              "properties": {
                "zoneId": { "type": "string" },
                "materialId": { "type": "string" },
                "colorId": { "type": "string" }
              }
            }
          }
        },
        "ambientLightingPreset": {
          "type": "object",
          "description": "3D visual lighting preset (Asset feature, unconfirmed customer dimension in V1)",
          "required": ["optionId", "colorHex"],
          "properties": {
            "optionId": { "type": "string" },
            "colorHex": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6})$" }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
