{
  "name": "autolab-digital-showroom",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "AutoLab Digital Showroom — Interactive 3D Automotive Interior Configurator & Sales Atelier",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "validate:asset": "node scripts/validate-glb.mjs --scope spike --feasibility-webp",
    "validate:fixture": "node scripts/make-fixture.mjs --draco && node scripts/validate-glb.mjs --scope spike --asset tests/fixtures/spike-synthetic.glb --synthetic --report reports/synthetic-glb-report.json",
    "validate:lexus": "node scripts/validate-glb.mjs --scope lexus",
    "validate:lexus:fixture": "node scripts/make-fixture.mjs --scope lexus --draco tests/fixtures/lexus-synthetic.glb && node scripts/validate-glb.mjs --scope lexus --asset tests/fixtures/lexus-synthetic.glb --synthetic --report reports/lexus-synthetic-glb-report.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.441.0",
    "next": "16.4.2",
    "postgres": "^3.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "draco3dgltf": "1.5.9",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
