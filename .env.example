# Copy to .env.local and fill in. NEVER commit .env.local. NEVER put real values in this file.

# AutoLab WhatsApp Business number, digits only with country code, e.g. 2547XXXXXXXX (GATE-07)
NEXT_PUBLIC_AUTOLAB_WHATSAPP_NUMBER=

# Public site URL (used for share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables the test hook window.__autolab. Keep 0 in production.
NEXT_PUBLIC_E2E=0

# Supabase (single backend, decision D5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public by design: safe ONLY with row-level security enabled

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
