{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigurationState",
  "type": "object",
  "required": [
    "referenceCode",
    "vehicleId",
    "createdAt",
    "updatedAt",
    "selections"
  ],
  "properties": {
    "referenceCode": { "type": "string", "pattern": "^AL-[A-Z0-9]{2,4}-[0-9]{4}-[A-Z0-9]{4}$" },
    "vehicleId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "selections": {
      "type": "object",
      "required": ["primaryUpholstery", "trimDeck", "steeringWheel"],
      "properties": {
        "primaryUpholstery": {
          "type": "object",
          "required": ["zoneId", "materialId", "colorId"],
          "properties": {
            "zoneId": { "type": "string" },
            "materialId": { "type": "string" },
            "colorId": { "type": "string" },
            "accentThreadId": { "type": "string" }
          }
        },
        "secondaryAccent": {
          "type": "object",
          "required": ["zoneId", "materialId", "colorId"],
          "properties": {
            "zoneId": { "type": "string" },
            "materialId": { "type": "string" },
            "colorId": { "type": "string" },
            "accentThreadId": { "type": "string" }
          }
        },
        "trimDeck": {
          "type": "object",
          "required": ["zoneId", "materialId", "colorId"],
          "properties": {
            "zoneId": { "type": "string" },
            "materialId": { "type": "string" },
            "colorId": { "type": "string" }
          }
        },
        "steeringWheel": {
          "type": "object",
          "required": ["zoneId", "materialId", "colorId"],
          "properties": {
            "zoneId": { "type": "string" },
            "materialId": { "type": "string" },
            "colorId": { "type": "string" }
          }
        },
        "ambientLighting": {
          "type": "object",
          "required": ["optionId", "colorHex"],
          "properties": {
            "optionId": { "type": "string" },
            "colorHex": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6})$" }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
